[Unit]
Description=Mikroskop-Auswertung 1.4 (Erkennung, Verfolgung, Anzeige, Aufzeichnung; neu aufgesetzt 05.11.2026)
After=network.target mikroskop-fokus.service
Wants=mikroskop-fokus.service
[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 -u /home/pi/auswertung_1.4.py
Restart=always
RestartSec=5
Nice=10
[Install]
WantedBy=multi-user.target
